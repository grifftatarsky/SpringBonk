# TODO: Replace localhost with container names? Ah. Create a dupe with docker setup.
# Resource / Datasource ############################################################################
RESOURCE_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resource-db
RESOURCE_DATASOURCE_NAME=resource-db
RESOURCE_DATASOURCE_USERNAME=resource_user
RESOURCE_DATASOURCE_PASSWORD=resource_password
# Resource / Routing ###############################################################################
PORT_RESOURCE_SERVER=7084
SCHEME_RESOURCE_SERVER=http
PREFIX_RESOURCE=/api
CONTAINER_NAME_RESOURCE=localhost
SWAGGER_PATH_RESOURCE=/swagger-ui.html
