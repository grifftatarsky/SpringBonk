# The deck.gl 9.4 betas ship peer ranges that contradict their own release:
# @deck.gl/layers@9.4.0-beta.1 asks for @deck.gl/core@~9.3.0-beta.2 while
# @deck.gl/maplibre@9.4.0-beta.1 asks for ~9.4.0-alpha.2, and neither matches the
# 9.4.0-beta.1 core they were published alongside. It is stale metadata, not a
# real incompatibility, but npm refuses the tree without this — including
# `npm ci` in CI.
#
# Remove this when deck.gl 9.4 ships stable and the ranges are corrected.
legacy-peer-deps=true
